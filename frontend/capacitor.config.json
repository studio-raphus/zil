{
  "appId": "mu.zil.app",
  "appName": "Zil",
  "webDir": "dist",
  "server": { "androidScheme": "https" },
  "android": { "backgroundColor": "#FFF6E6" },
  "plugins": {
    "SplashScreen": { "launchAutoHide": false, "launchShowDuration": 4000, "backgroundColor": "#45B8FF", "showSpinner": false, "androidScaleType": "CENTER_CROP" },
    "PushNotifications": { "presentationOptions": ["badge", "sound", "alert"] },
    "SocialLogin": { "providers": { "google": true, "facebook": false, "apple": false, "twitter": false } }
  }
}
