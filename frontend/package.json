{
  "name": "@zil/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zil Phase 1 web app (PWA) and Android shell",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:assets": "npx --yes @capacitor/assets@3.0.5 generate --android --iconBackgroundColor '#45B8FF' --splashBackgroundColor '#45B8FF' --splashBackgroundColorDark '#15142B'",
    "android:run": "npm run android:sync && npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.3",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capgo/capacitor-social-login": "8.7.3",
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "5.24.0",
    "pmtiles": "4.5.0",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "vite": "^5.4.10"
  }
}
